# --- Supabase (обязательно для избранного, коллекций, отзывов, профиля) ---
# Локально: скопируйте в .env (в git не попадает).
# CI / Pages: значения в .env.production (коммитится в приватный fork).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# --- Monitoring / analytics (опционально) ---
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Базовый путь (GitLab Pages / подпапка на домене). Локально оставьте "/" ---
# VITE_BASE_PATH=/bookverse/
